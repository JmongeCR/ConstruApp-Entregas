<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <!-- AspNetCoreModuleV2 — requiere .NET Hosting Bundle instalado en el servidor -->
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore
        processPath="dotnet"
        arguments=".\ConstruApp.API.dll"
        stdoutLogEnabled="true"
        stdoutLogFile=".\logs\stdout"
        hostingModel="inprocess">

        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!--
            Configurar desde el panel de MonsterASP.NET o aquí con valores reales:
            <environmentVariable name="CONNECTION_STRING"  value="Server=...;Database=...;User Id=...;Password=...;" />
            <environmentVariable name="JWT_SECRET_KEY"     value="clave-secreta-larga" />
            <environmentVariable name="GROQ_API_KEY"       value="gsk_..." />
            <environmentVariable name="EMAIL_USER"         value="tu@gmail.com" />
            <environmentVariable name="EMAIL_PASSWORD"     value="app-password" />
          -->
        </environmentVariables>
      </aspNetCore>

      <!-- WebSocket Protocol — requiere que esté habilitado en IIS -->
      <webSocket enabled="true" />

      <!-- Seguridad: ocultar versión del servidor -->
      <security>
        <requestFiltering removeServerHeader="true" />
      </security>

      <!-- Logs: crear carpeta logs/ antes de subir -->
      <httpErrors errorMode="DetailedLocalOnly" />

    </system.webServer>
  </location>
</configuration>
